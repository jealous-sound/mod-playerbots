         void OnPlayerCreatureKill(Player* player, Creature* killed) override
         {
+            // Town defense owns temporary waves whose native kill rewards and challenge objectives are disabled.
+            if (killed && killed->IsSummon() && killed->IsLootRewardDisabled() &&
+                killed->CustomData.Get<DataMap::Base>("coa.activity.rewardless_wave"))
+                return;
             CreditKill(player, killed);
             FailForbiddenKill(player, killed);
         }
